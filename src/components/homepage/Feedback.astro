---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Swiper from "../Swiper.astro";
import { reviews } from "../../data/reviews";

---

<section class="section section-reviews">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div>
        <h2>Review Pelanggan Sedot WC Alam Jaya Tangerang</h2>  
        <p class="mt-4">
      Lihat pengalaman pelanggan yang telah menggunakan layanan Sedot WC Alam Jaya.
      Kami melayani kebutuhan sedot WC, septic tank, WC mampet, dan saluran
      pembuangan untuk area Tangerang dan sekitarnya.
         </p>
      </div>

      
      <div>
        <Swiper
          pagination={false}
          navigation={true}
          id="mySwiper"
          prev="swiper-prev"
          next="swiper-next"
        >
        {
  reviews.map((review) => (
    <div class="swiper-slide">
      <article
        class="rounded-xl p-10 grid grid-cols-1 sm:grid-cols-[100px_1fr] gap-4 items-center border border-gray-200 border-t-4 border-t-main border-r-4 border-r-main relative"
      >
       <div
        class="w-24 h-24 rounded-full bg-main text-white flex items-center justify-center text-3xl font-bold shrink-0">
        {review.initial}
      </div>

        <div class="grid gap-0">
          <div class="flex flex-wrap justify-between items-center gap-4">
            <div>
              <p class="text-lg font-semibold">{review.name}</p>
              <p>{review.role}</p>
              <p class="text-xs text-gray-500">{review.time}</p>
            </div>

            <Image
              src="/img/icons/quote.svg"
              width={50}
              height={50}
              alt="quote"
              class="w-auto h-auto max-w-18.75 absolute top-2 right-2"
            />
          </div>

          <div class="flex gap-1 items-center text-yellow-500 mt-2 mb-4">
            {
              Array.from({ length: review.rating }).map(() => (
                <Icon name="heroicons:star-solid" size={24} />
              ))
            }
          </div>

          <p class="text-sm">
            {review.review}
          </p>
        </div>
      </article>
    </div>
  ))
}
        </Swiper>
      </div>
    </div>
  </div>
</section>
<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";

  new Swiper("#mySwiper", {
    modules: [Navigation],
    loop: true,

    navigation: {
      nextEl: ".swiper-next",
      prevEl: ".swiper-prev",
    },
  });
</script>
