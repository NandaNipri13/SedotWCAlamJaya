---
import ServiceCard from "../../components/card/ServiceCard.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("service"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<section id="services" class="py-20">
  <div class="container">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4 border-b border-b-main pb-10"
    >
      <h2 class="capitalize">Layanan Kami</h2>
      <div>
        <div class="flex flex-wrap justify-between items-center gap-3">
          <p class="font-semibold mb-3 text-xl">Solusi Lengkap untuk Kebutuhan Sanitasi</p>
          
        </div>
        <p class="mb-3">
          Kami melayani sedot WC, sedot septic tank, saluran mampet,
          grease trap, hingga penyedotan limbah dengan armada profesional.
        </p>
      </div>
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10 mt-10 relative"
    >
      {services.map((service) => <ServiceCard {...service} />)}
    </div>
  </div>
</section>
