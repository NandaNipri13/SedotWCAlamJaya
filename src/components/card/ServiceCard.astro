---
import { Image } from "astro:assets";

const { data } = Astro.props;

const WA = `https://wa.me/6286289531934761?text=${encodeURIComponent(
  `Halo, saya ingin bertanya mengenai layanan ${data.title}.`
)}`;
---

<article
  class="bg-[#1F2937] rounded-2xl overflow-hidden border border-gray-700 hover:border-green-500 hover:-translate-y-2 transition-all duration-300 shadow-lg"
>
  <Image
    src={data.thumbnail}
    alt={data.title}
    width={500}
    height={300}
    class="w-full h-56 object-cover"
  />

  <div class="p-6">
    <h3 class="text-2xl font-bold mb-3">
      {data.title}
    </h3>

    <p class="text-gray-300 mb-6">
      {data.description}
    </p>

    <a
      href={WA}
      target="_blank"
      class="btn bg-main border-main text-white hover:bg-green-600 rounded-lg w-full"
    >
      WhatsApp Sekarang
    </a>

  </div>
</article>