---
import Image from "astro/components/Image.astro";
const { mode = "light" } = Astro.props;
---

<a href="/" class="logo">
  <Image
    src="/img/LOGO2.png"
    alt="Sedot WC Alam Jaya"
    width={320}
    height={80}
    fetchpriority="high"
    loading="eager"
    class="h-16 w-auto dark:hidden"
  />

  <Image
    src="/img/LOGO2.png"
    alt="Sedot WC Alam Jaya"
    width={320}
    height={80}
    loading="eager"
    class="hidden h-16 w-auto dark:block"
  />
</a>
