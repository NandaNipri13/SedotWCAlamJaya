---
const today = new Date();
import Logo from "./Logo.astro";
---

<footer 
id="contact"
class="footer bg-dark text-white gap-0 block">
  <div class="footer-top w-full py-20">
    <div class="container">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">

        <!-- Company -->
        <div>
          <Logo mode="dark" />

          <p class="mt-4 leading-7 text-gray-300">
            Sedot WC Alam Jaya melayani jasa sedot WC, sedot septic tank,
            saluran mampet, dan layanan limbah domestik untuk wilayah
            Tangerang dan sekitarnya dengan pelayanan cepat, profesional,
            dan harga yang transparan.
          </p>
        </div>

        <!-- Menu -->
        <div class="grid grid-cols-2 gap-10">

          <nav class="grid gap-3">
            <h3 class="text-xl font-semibold">Menu</h3>

            <a href="/" class="hover:text-main transition">Beranda</a>
            <a href="/#about" class="hover:text-main transition">Layanan</a>
            <a href="/#services" class="hover:text-main transition">Area Layanan</a>
            <a href="/#contact" class="hover:text-main transition">Kontak Kami</a>
          </nav>

          <nav class="grid gap-3">
            <h3 class="text-xl font-semibold">Kami Melayani</h3>

            <span>Sedot WC</span>
            <span>Sedot Septic Tank</span>
            <span>Saluran Mampet</span>
            <span>Limbah Domestik</span>
          </nav>

        </div>

        <!-- Contact -->
        <div class="grid gap-4">

          <h3 class="text-xl font-semibold">
            Butuh Bantuan Kami?
          </h3>

          <p class="text-gray-300">
            Melayani wilayah tangerang dan sekitarnya 24 jam
          </p>

          <a
            href="https://wa.me/6289531934761"
            target="_blank"
            class="btn bg-main border-main text-white rounded-lg hover:bg-green-600 shadow-none lg:mr-auto"
          >
            💬 Hubungi ke WhatsApp
          </a>

          <div class="text-sm text-gray-400">
            Fast Response • Professional Team • Transparent Pricing
          </div>

        </div>

      </div>
    </div>
  </div>

  <div class="footer-btm w-full">
    <div class="container text-center border-t border-white/20 py-8 text-sm text-gray-400">
      © {today.getFullYear()} Sedot WC Alam Jaya. All Rights Reserved.
    </div>
  </div>
</footer>